# Nunca coloque a senha real do administrador neste arquivo versionado.
GCM_DEMO_MODE=false

# Local: deixe em branco para usar gcm_database.db ao lado do main.py.
# Render com Persistent Disk montado: /var/data/gcm_database.db
GCM_DB_PATH=

# Primeiro administrador (obrigatório para um banco remoto vazio).
GCM_BOOTSTRAP_ADMIN_MATRICULA=9001
GCM_BOOTSTRAP_ADMIN_NOME=Administrador Inicial
GCM_BOOTSTRAP_ADMIN_PASSWORD=ALTERE_E_NAO_COMITE
